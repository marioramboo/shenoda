{
  "name": "shenoda-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Church Service Management System (نظام إدارة الخدمة الكنسية)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@shenoda/web",
    "dev:api": "npm run dev --workspace=@shenoda/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
